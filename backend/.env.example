# Backend Environment Variables — copy to .env and fill in real values

# MongoDB Atlas connection string
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=smart_agriculture

# JWT configuration
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — set to your Vercel frontend URL in production
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Open-Meteo does not require an API key (free, no-auth API)
# Leave blank or set a custom base URL if using a self-hosted instance
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Sensor simulator — used by simulator/sensor_simulator.py
BACKEND_URL=http://localhost:8000

# Environment: development | production
ENVIRONMENT=development
